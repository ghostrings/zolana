# privacycash.fun — server and operator settings.
# Copy to .env and fill in. Never commit .env. Keys marked SECRET must not leave this machine.
#
# This project runs on Solana MAINNET only. There is no devnet or test mode: every value here
# is a mainnet value, every transaction is real, and the server refuses to start or to relay
# if its RPC is any other network.

# ---------------------------------------------------------------- Helius
# Mainnet API key. SECRET. The browser never sees it: the server relays RPC and Rings requests.
HELIUS_API_KEY=

# Optional, only if you use a dedicated mainnet endpoint instead of mainnet.helius-rpc.com.
# The server checks the genesis hash and refuses anything that is not mainnet-beta.
# SOLANA_RPC_URL=
# SPR_URL=

# Every proof a visitor's browser requests is billed to your Helius key (about 1,000 credits each;
# a private transfer, withdrawal, shielded trade or Ghost fill leg needs one). These bound that spend.
PROOFS_PER_MINUTE_PER_IP=12
PROOFS_DAILY_LIMIT=5000

# ---------------------------------------------------------------- server
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data

# The site's public origin. REQUIRED. It is written into every token's metadata address, on
# mainnet, for good. Use your real https origin. http://localhost:8080 is accepted for running
# on your own machine, and then launches are refused unless PINATA_JWT is set (see below).
# The operator scripts on your computer use it too: `npm run fees:status` and
# `npm run configs:retire` ask this address which pairs and configs the live site uses, and
# print the lines the .env on your computer lacks.
PUBLIC_ORIGIN=https://privacycash.fun

# Other addresses the same site is reachable at, separated by commas. Optional. The site works
# only at PUBLIC_ORIGIN and the addresses listed here: opened anywhere else, pages load but
# every request that sends something is refused ("CROSS_ORIGIN"). Typical use: the hosting
# platform's own address next to your domain. A ghost wallet is kept by the browser under the
# address it was made at, so give your users one address and keep the others for yourself.
# EXTRA_ORIGINS=https://privacycash.onrender.com

# Per-visitor rate limits need the visitor's real address. Use ONE of these two:
#  - TRUST_PROXY: the number of reverse proxies in front of the server (0 if none).
#  - CLIENT_IP_HEADER: a header your hosting platform's edge sets to the visitor's address,
#    overwriting anything the visitor sent. On Render: cf-connecting-ip.
# After deploying, open /api/ip on your site: it must show your own address.
TRUST_PROXY=0
# CLIENT_IP_HEADER=cf-connecting-ip

# Minutes between full scans of Meteora's program for pools under your configs. A safety net:
# tokens launched through the site are listed at once without it. 0 turns it off.
DISCOVERY_MINUTES=10

# ---------------------------------------------------------------- fee tiers
# The platform's wallet. It receives the platform's share of curve fees, and after a token
# graduates it owns the one locked liquidity position, which collects all of the pool's fees.
# It becomes the fee claimer of the three configs and cannot be changed afterwards.
PARTNER_WALLET=

# Filled in by `npm run configs:apply yes mainnet` (it prints these lines).
# One immutable Meteora config per tier.
DBC_CONFIG_200=
DBC_CONFIG_300=
DBC_CONFIG_400=

# Configs kept from an EARLIER set, separated by commas. A config can never be edited, so
# changing the fee split (or a curve's size) means creating a new set for new launches. The old
# addresses then move here: every token launched on them stays listed, trades, earns and is
# claimed exactly as before, with the split it was launched with, and nothing new launches on
# them. `npm run configs:retire write 80` writes this line for you, into a copy of this file;
# Part I of docs/MAINNET_RUNBOOK.md is the whole procedure. Leave it out of a first setup.
# DBC_CONFIGS_PREVIOUS=

# Launch economics. They are baked into the configs when they are created, and the server
# checks at start that these values are the ones its configs were created with (launches are
# refused otherwise). Run `npm run configs:plan` to see what they produce.
#
# FIRST RUN: docs/MAINNET_RUNBOOK.md starts with a small set (1 and 10: a curve completes at
# about 2.4 SOL) so a token's whole life, graduation included, can be checked with a few SOL.
# Then a second set is created with the production values below.
CURVE_INITIAL_MARKET_CAP_SOL=30
CURVE_MIGRATION_MARKET_CAP_SOL=420
# ON THE CURVE: the creator's share of each fee after Meteora's 20% protocol share. It accrues
# on chain and the creator claims it from the site. 30 -> creator 24%, platform 56%, Meteora 20%.
# Baked into the configs: permanent.
CREATOR_FEE_SHARE_PCT=30
MIGRATION_FEE_PCT=0
CREATOR_MIGRATION_FEE_SHARE_PCT=0

# ---------------------------------------------------------------- pair tokens
# What a launched token can be priced and traded in. SOL is always on and uses the settings
# above. Every other pair token is OFF until you switch it on, one at a time:
#
#     USDC   ZEC   NEAR   XMR   ANT   RENDER   HSOL (the ticker hSOL)
#
# To switch one on (USDC as the example):
#   1. `npm run doctor`            shows what the token's mint really is on chain, whether Rings can
#                                  hold it, and suggests a curve worth what your SOL curve is.
#   2. Set its curve size below, in whole tokens of the pair. PERMANENT once its configs exist.
#   3. `npm run configs:plan USDC` prints exactly what would be created. Read it.
#   4. `npm run configs:apply yes mainnet USDC`   (with DEPLOYER_KEY set in that shell) creates the
#                                  pair's three configs, and its Rings interface if it has none.
#                                  It prints the DBC_CONFIG_*_USDC lines to put here.
#   5. Put the same five lines in the hosting platform's settings and deploy again.
#
# The server reads each pair token's mint from chain when it starts. A pair is used only if the
# mint is an ordinary SPL Token mint with the decimals this build expects, Rings has an interface
# for it, and its configs are the ones this file's sizes would create. Otherwise it stays off and
# the log says why. A pair with no size here is simply not in use.
#
# Graduation: Meteora's keeper moves completed SOL curves (10 SOL or more) and USDC curves
# (750 USDC or more) by itself. For any other pair token it does so only if Jupiter lists the
# token as verified with an organic score above 50 and the curve raises over $750. Otherwise a
# completed curve waits until somebody sends the graduation: anyone can from the token's page,
# or you with `npm run migrate <mint> yes`.
#
# CURVE_INITIAL_MARKET_CAP_USDC=
# CURVE_MIGRATION_MARKET_CAP_USDC=
# DBC_CONFIG_200_USDC=
# DBC_CONFIG_300_USDC=
# DBC_CONFIG_400_USDC=
#
# The same five names with ZEC, NEAR, XMR, ANT, RENDER or HSOL in place of USDC.

# AFTER GRADUATION all liquidity is locked for good in one position, and that position is the
# platform's (PARTNER_WALLET). Creators hold none of it. This is fixed in the code, not a setting.
# The platform's position collects every pool fee, and `npm run fees:claim yes` passes this
# percentage of what it claims on to each token's creator, in the same transaction as the claim.
# Unset, it follows CREATOR_FEE_SHARE_PCT. 0 pays creators nothing after graduation.
# This one is your policy, not a term of any config: it is not on chain, it can be changed, and
# creators are paid only when you run the claim. The site states the percentage to creators.
CREATOR_POOL_PAYOUT_PCT=30

# ---------------------------------------------------------------- trading
DEFAULT_SLIPPAGE_BPS=100
MAX_SLIPPAGE_BPS=1000

# Priority fee, as a price per compute unit in micro-lamports. The server follows Helius's live
# estimate between these two bounds, and uses the lower one when there is no estimate.
# At 20,000 a shielded trade pays about 0.000018 SOL; at 2,000,000 about 0.0018 SOL.
PRIORITY_FEE_MIN_MICROLAMPORTS=20000
PRIORITY_FEE_MAX_MICROLAMPORTS=2000000

# ---------------------------------------------------------------- operator limits
# Largest single trade or first buy through the site, in lamports. 0 = no cap.
# This code has never run with real funds before your first day. A cap keeps a mistake small;
# raise it or set it to 0 when you are satisfied. 2000000000 = 2 SOL.
# For a token priced in another pair token the same cap applies at that pair's sizing rate
# (its starting market cap over the SOL curve's), so there it is approximate.
MAX_TRADE_LAMPORTS=2000000000

# Switches for when something needs looking into. YES or NO; restart to apply.
# They stop new launches or new trades from the site. The wallet page is never affected:
# deposits, withdrawals and private transfers always work.
PAUSE_LAUNCHES=NO
PAUSE_TRADING=NO
# PAUSE_MESSAGE=Back shortly.

# ---------------------------------------------------------------- paying with SOL or USDC
# With a Jupiter API key, a token can be paid for in SOL or USDC whatever it is priced in, and
# sold for them: the token page gets a "Pay with" choice, and the conversion runs on Jupiter
# inside the same transaction as the trade. Without a key that choice is not shown, and a token
# is paid for in its own pair token only.
#
# The key is free at https://developers.jup.ag/portal. It stays on this server: pages ask this
# server, and this server asks Jupiter. Jupiter is told the wallet address, the two tokens and
# the amount of each conversion it is asked for.
#
# `npm run doctor` asks Jupiter, with this key, for every conversion the site could be asked
# for, and reads each answer the way the pages do. Run it after setting the key, and again
# after switching a pair on.
# JUPITER_API_KEY=

# Requests a second your Jupiter plan allows. A free key allows 1; the paid plans 10, 50, 150.
# Every quote a visitor sees, and every trade they send, is one request, shared between all
# visitors. Over this the site tells people the converter is busy instead of failing.
# JUPITER_RPS=1

# With the key set, the Swap page also buys and sells tokens that were NOT launched here:
# any token Jupiter can route, paid for in SOL or USDC, into and out of a private balance.
# It is on whenever the key is set. NO switches it off and leaves converting for tokens
# launched here as it was; the Swap page then says it is not switched on.
#
# Every quote on that page is one request to Jupiter under the allowance above, and
# MAX_TRADE_LAMPORTS applies to the SOL or USDC side of each trade there, on the server as
# well as on the page. `npm run doctor` asks for three such swaps and reads the answers.
# SWAP_ANY_TOKEN=YES

# ---------------------------------------------------------------- artwork
# With a Pinata JWT, artwork and metadata are pinned to IPFS and do not depend on this server.
# Recommended. Without it they are served from DATA_DIR.
# PINATA_JWT=

# The IPFS gateway written into each new token's metadata. It must end in /ipfs. A token's
# metadata cannot be changed after launch, so this decides for good where wallets and
# explorers load that token's name and logo from. Three choices:
#  - Unset: Pinata's shared public gateway. No setup. Pinata throttles it for everyone and
#    describes it as for testing, so a busy token's logo can fail to load on other sites.
#  - Your own Pinata gateway (Pinata dashboard, Gateways): https://NAME.mypinata.cloud/ipfs
#    Not throttled. Its traffic counts against your Pinata plan.
#  - This site: https://privacycash.fun/ipfs  The server answers those addresses from its own
#    disk. Only use an address that already opens this site and that you will keep.
# The choice does not affect this site's own pages: they always load artwork from the copy
# this server keeps (next setting), whichever gateway a token names.
# PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# The server keeps a copy of every file it pins in DATA_DIR/ipfs and serves it at
# /ipfs/<identifier>, so a logo on this site never depends on the visitor being able to reach
# an IPFS gateway. This is the most disk those copies may use, in MB. Past it, the oldest are
# removed; a removed copy is fetched from IPFS again the next time it is shown.
# ARTWORK_CACHE_MB=500

# Artwork to take down from this site: IPFS identifiers (the last part of an artwork address),
# separated by commas. They are never stored, served or fetched here, and their tokens show
# the generated pixel mark instead.
# ARTWORK_BLOCKLIST=

UPLOAD_DAILY_LIMIT=1000

# ---------------------------------------------------------------- fee modules (off by default)
# Lets a token's creator have their share of the fees bought back and burned, shared between
# wallets, or both, automatically. The creator hands the pool's creator role to a wallet this
# server derives for that token, and the server pays the fees out on a schedule.
# Read docs/MAINNET_RUNBOOK.md, Part J, first.
MODULES_ENABLED=NO
# Also required when modules are on. Setting it says you have read Part J.
# MODULES_MAINNET_ACK=YES
# SECRET, SERVER ONLY. One line of base58 from `npm run modules:new`. Every module wallet follows
# from it. Keep a copy offline and NEVER change it: with a different seed the creator fees of
# every token that already has modules can no longer be reached by anyone.
# MODULES_SEED=
# Not a secret. The address `npm run modules:new` printed with the seed. The server refuses to
# run modules when the seed does not belong to it. Keep this wallet funded with SOL: it pays the
# modules' network fees and the rent of the token accounts they need.
# MODULES_GAS_TANK=
# YES: every pass is worked out and run against the chain, and nothing is sent. Start with this.
MODULES_DRY_RUN=NO
# Minutes between passes over the tokens that have modules.
MODULES_EVERY_MINUTES=15
# The least a pass acts on, in lamports of creator fees (0.02 SOL). Less than that waits.
MODULES_MIN_LAMPORTS=20000000
# The most one buyback spends, in lamports (1 SOL). The rest waits for the next pass.
MODULES_MAX_BUY_LAMPORTS=1000000000
# How far a buyback's price may move before it is not sent, in hundredths of a percent.
MODULES_SLIPPAGE_BPS=100

# ---------------------------------------------------------------- Ghost desk (off by default)
# The desk is a hot wallet that trades with users. Read docs/MAINNET_RUNBOOK.md, Part E, first.
GHOST_DESK_ENABLED=NO
# Also required when the desk is on. Setting it says you have read Part E and that the desk's
# key holds only what you can afford to lose.
# GHOST_DESK_MAINNET_ACK=YES
# SECRET. Base58 or a JSON byte array. Use a dedicated wallet holding only what you can afford to lose.
# `npm run desk:new` makes one. Fund it with more than 0.6 SOL: the desk keeps 0.3 SOL public for
# fees and trades only from its private balance, which it fills from whatever it holds above that.
# DESK_SECRET_KEY=
DESK_SPREAD_BPS=50
DESK_MAX_ORDER_LAMPORTS=2000000000
DESK_MAX_IMPACT_BPS=150
DESK_QUOTE_TTL_MS=20000
DESK_TARGET_INVENTORY_LAMPORTS=1000000000
DESK_REBALANCE_SECONDS=90
DESK_MAX_SLIPPAGE_BPS=150
# Mints the desk keeps stocked so buys can be filled. Comma-separated. Empty: it stocks nothing.
# DESK_STOCK_MINTS=
# YES: the desk merges a balance of its own that has split across more notes than one fill can
# spend (a fill spends up to five). Leave it off until you have seen one consolidation work on
# mainnet, from the wallet page; until then the log says when a balance is getting split.
# DESK_AUTO_CONSOLIDATE=NO

# ---------------------------------------------------------------- Rings explorer (on by default)
# The Rings page (/rings) shows what anyone can read of Solana Privacy Rings: tokens held
# privately, shields and unshields, and which wallets paid each other. The server follows the
# Rings program to fill it. It only reads: it holds no key and sends nothing.
# What it costs on your Helius plan: one request per pass for the program's new signatures, one
# per new transaction, one more for each private transfer, and vault balances a hundred at a time.
# NO switches it off; the page then says so.
# RINGS_EXPLORER=YES
# Seconds between passes (15 to 3600).
# RINGS_POLL_SECONDS=45
# Days of history read back once, the first time it runs (0 to 365). It reads about sixty
# transactions a pass until it gets there, and the page says from which day its lists start.
# RINGS_BACKFILL_DAYS=30

# ---------------------------------------------------------------- operator scripts only
# Export these in your shell when you run the script that needs them. Do not keep them in this file.
# DEPLOYER_KEY=   pays for `configs:apply` and `migrate`
# PARTNER_KEY=    the key of PARTNER_WALLET, for `fees:claim`
