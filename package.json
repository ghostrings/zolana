{
  "name": "privacycash-fun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "privacycash.fun \u2014 a Solana launchpad where balances, transfers and fills run through Solana Privacy Rings, with launches on Meteora DBC.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.node.json",
    "start": "node --env-file-if-exists=.env build/server/src/index.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "doctor": "tsx --env-file-if-exists=.env ops/doctor.ts",
    "configs:plan": "tsx --env-file-if-exists=.env ops/configs.ts plan",
    "configs:apply": "tsx --env-file-if-exists=.env ops/configs.ts apply",
    "configs:verify": "tsx --env-file-if-exists=.env ops/configs.ts verify",
    "configs:retire": "tsx --env-file-if-exists=.env ops/configs.ts retire",
    "verify:graduated": "tsx --env-file-if-exists=.env ops/verify-graduated.ts",
    "migrate": "tsx --env-file-if-exists=.env ops/migrate.ts",
    "fees:status": "tsx --env-file-if-exists=.env ops/fees.ts status",
    "fees:claim": "tsx --env-file-if-exists=.env ops/fees.ts claim",
    "modules:new": "tsx ops/modules.ts new",
    "modules:status": "tsx --env-file-if-exists=.env ops/modules.ts status",
    "desk:new": "tsx ops/desk.ts new",
    "desk:address": "tsx --env-file-if-exists=.env ops/desk.ts address",
    "desk:register": "tsx --env-file-if-exists=.env ops/desk.ts register",
    "desk:status": "tsx --env-file-if-exists=.env ops/desk.ts status",
    "desk:check": "tsx --env-file-if-exists=.env ops/desk.ts check",
    "desk:fills": "tsx --env-file-if-exists=.env ops/desk.ts fills",
    "markets:check": "node ops/check-native-markets.mjs",
    "markets:observe": "tsx ops/markets-observe.ts",
    "markets:pilot:check": "node --test protocol/ghost-markets-pilot/tests/quote.test.mjs protocol/ghost-markets-pilot/tests/lifecycle.test.mjs protocol/ghost-markets-pilot/tests/pilot-profile.test.mjs protocol/ghost-markets-pilot/tests/security-txt.test.mjs",
    "markets:pilot:local": "bash protocol/ghost-markets-pilot/scripts/test-pilot.sh",
    "markets:lab:check": "node --test protocol/ghost-markets-pilot/tests/lab-core.test.mjs",
    "markets:pilot:lab": "bash protocol/ghost-markets-pilot/scripts/native-lab.sh",
    "markets:prepare:v33": "bash protocol/ghost-markets-pilot/scripts/prepare-v33-review.sh",
    "markets:wallet:check": "node --test protocol/ghost-markets-pilot/tests/wallet-wire.test.mjs",
    "markets:wallet:local": "bash protocol/ghost-markets-pilot/scripts/test-wallet-client.sh",
    "markets:production:check": "node ops/check-native-production.mjs",
    "markets:production:preflight": "tsx ops/native-production.ts preflight",
    "markets:production:init-plan": "tsx ops/native-production.ts initialization-plan",
    "markets:production:client-check": "tsx --test tests/native-production-client.node.mjs",
    "markets:production:approval": "tsx ops/native-approval.mjs",
    "markets:owner-launch": "tsx ops/v33-first-launch.mjs",
    "markets:native-asset": "tsx ops/v33-native-asset.mjs",
    "markets:owner-launch:check": "tsx --test tests/v33-first-launch.node.mjs",
    "markets:browser:check": "node --test tests/native-browser-policy.node.mjs",
    "markets:browser:client-check": "tsx --test tests/native-browser-envelope.node.mjs",
    "markets:admin:browser": "tsx ops/native-browser-admin.mjs",
    "markets:live:check": "node --test tests/native-market-live.node.mjs",
    "markets:live:client-check": "tsx --test tests/native-market-session.node.mjs",
    "markets:unified:check": "node --test tests/native-unified-market.node.mjs",
    "markets:owner-trading:check": "node --test tests/native-owner-trading.node.mjs",
    "markets:token-ui:check": "node --test tests/native-token-ui.node.mjs",
    "markets:v41:check": "node --test tests/v41-profile.node.mjs protocol/ghost-markets-v41/tests/quote.test.mjs protocol/ghost-markets-v41/tests/lifecycle.test.mjs protocol/ghost-markets-v41/tests/security-txt.test.mjs",
    "markets:v41:local": "bash protocol/ghost-markets-v41/scripts/test-pilot.sh",
    "markets:prepare:v41": "bash protocol/ghost-markets-v41/scripts/prepare-v41-review.sh",
    "markets:confidential:local": "bash protocol/ghost-confidential-settlement/scripts/test-local.sh",
    "markets:v41:compat": "bash protocol/ghost-markets-v41/scripts/test-compat.sh",
    "markets:v41:client-check": "tsx --test tests/v41-client.node.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@heliuslabs/spr": "0.9.0-alpha",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "2.0.0",
    "@solana/kit": "^8.3.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@wallet-standard/app": "1.1.0",
    "bn.js": "5.2.2",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "decimal.js": "10.6.0",
    "express": "^5.1.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/bn.js": "5.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^5.1.1"
  }
}
